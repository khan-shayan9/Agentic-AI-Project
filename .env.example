# Copy this file to .env and fill in your own free keys. Never commit .env.

# Optional: Mistral API, only if you use --verifiers llama,mistral,phi (the default Mistral 7B runs locally).
# https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# Optional: Groq free plan, only if you want to try gpt-oss-120b as an extra verifier.
GROQ_API_KEY=

# NCBI PubMed E-utilities (evidence agent). Email is required by NCBI policy.
# A free API key raises the limit from 3 to 10 requests per second:
# https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_EMAIL=
NCBI_API_KEY=

# Only needed if Hugging Face asks you to log in to download MedHallu.
HF_TOKEN=

# Ollama (local Llama verifier). Default works for Colab and laptops.
OLLAMA_BASE_URL=http://localhost:11434/v1
